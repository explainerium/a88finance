// A88 Finance — admin dashboard data model.
// PostgreSQL (Neon) via Prisma. See /src/lib for the access layer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (CLI) and is passed
  // to PrismaClient via a driver adapter at runtime (src/lib/prisma.ts).
}

enum Role {
  ADMIN
  AUTHOR
}

model User {
  id             String    @id @default(cuid())
  name           String?
  image          String? // profile picture URL
  username       String?   @unique // optional alternate login identifier
  email          String    @unique // primary login identifier
  hashedPassword String // bcrypt hash — never plaintext
  role           Role      @default(AUTHOR)
  deletedAt      DateTime? // soft-delete safety net
  posts          Post[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([deletedAt])
}

model Post {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?    @db.Text // auto-generated from content
  content         String     @db.Text // Markdown or HTML
  metaTitle       String? // custom SEO <title>
  metaDescription String? // hand-written meta description (SEO-important)
  coverImage      String?
  coverImageAlt   String?
  categories      Category[] @relation("PostCategories")
  tags            Tag[]      @relation("PostTags")
  published       Boolean    @default(false)
  publishedAt     DateTime?

  // NOTE: no onDelete: Cascade — author deletion transfers posts (see deleteUser action).
  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([published, publishedAt])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique // powers /blog/category/[slug]
  description String?
  posts       Post[]  @relation("PostCategories")
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique // powers /blog/tag/[slug]
  posts Post[] @relation("PostTags")
}

model Settings {
  id              String   @id @default("singleton")
  siteName        String   @default("A88 Finance")
  siteDescription String?
  defaultOgImage  String?
  contactEmail    String?
  facebookUrl     String?
  linkedinUrl     String?
  instagramUrl    String?
  updatedAt       DateTime @updatedAt
}
